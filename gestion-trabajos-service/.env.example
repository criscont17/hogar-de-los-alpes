DATABASE_URL=postgresql+psycopg://trabajos:trabajos@localhost:5433/trabajos_db

# Adaptador de mensajería: logging (sin infraestructura) | pulsar
MESSAGE_BROKER=logging
PULSAR_URL=pulsar://localhost:6650
PULSAR_TOPICO_EVENTOS=persistent://public/default/eventos-trabajo
PULSAR_TOPICO_COMANDOS=persistent://public/default/comandos-trabajo
PULSAR_SUSCRIPCION_COMANDOS=gestion-trabajos
PULSAR_CONSUMIR_COMANDOS=false

# Resiliencia de la sincronización con cada partner B2B2C
PARTNER_CB_UMBRAL_FALLOS=3
PARTNER_CB_RECUPERACION_SEGUNDOS=10
PARTNER_SINCRONIZACION_ASINCRONA=true
