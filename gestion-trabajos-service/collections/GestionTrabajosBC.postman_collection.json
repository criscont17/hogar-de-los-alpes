                  "const t = pm.response.json();",
                  "const sub = c => t.sub_trabajos.find(s => s.categoria === c);",
                  "pm.test('queda asignado', () => pm.expect(sub('Plomeria').estado).to.eql('Asignado'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
