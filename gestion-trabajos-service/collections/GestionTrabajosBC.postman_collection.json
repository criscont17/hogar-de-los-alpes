  "item": [
    {
      "name": "01 Flujo Marketplace",
      "item": [
        {
          "name": "Crear trabajo (plomería → pintura)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('proveedor_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "const sub = c => t.sub_trabajos.find(s => s.categoria === c);",
                  "pm.collectionVariables.set('trabajo_id', t.id);",
                  "pm.collectionVariables.set('plomeria_id', sub('Plomeria').id);",
                  "pm.collectionVariables.set('pintura_id', sub('Pintura').id);",
                  "pm.test('canal Marketplace', () => pm.expect(t.canal).to.eql('Marketplace'));",
                  "pm.test('plomería arranca de inmediato', () => pm.expect(sub('Plomeria').estado).to.eql('Pendiente'));",
                  "pm.test('pintura espera a plomería', () => pm.expect(sub('Pintura').estado).to.eql('Bloqueado'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/trabajos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "trabajos"
              ]
            },
            "description": "Construye el flujo: lo que no tiene dependencias queda `Pendiente` y lo demás `Bloqueado`. Publica `TrabajoCreadoV1` (deprecado) y `TrabajoCreadoV2`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"Humedad en el muro de la cocina\",\n  \"urgencia\": \"Alta\",\n  \"ubicacion\": {\n    \"pais\": \"CO\",\n    \"ciudad\": \"Bogota\",\n    \"direccion\": \"Calle 80 # 20-10\"\n  },\n  \"moneda\": \"COP\",\n  \"sub_trabajos\": [\n    {\n      \"clave\": \"plomeria\",\n      \"categoria\": \"Plomeria\",\n      \"descripcion\": \"Reparar la fuga\"\n    },\n    {\n      \"clave\": \"pintura\",\n      \"categoria\": \"Pintura\",\n      \"descripcion\": \"Resanar y pintar\",\n      \"depende_de\": [\n        \"plomeria\"\n      ]\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Asignar proveedor a plomeria",
          "event": [
