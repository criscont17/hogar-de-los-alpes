DATABASE_URL=postgresql+psycopg://operaciones:operaciones@localhost:5434/operaciones_db

# Adaptador hacia GestionDeTrabajosBC: logging (sin infraestructura) | pulsar
MESSAGE_BROKER=logging
PULSAR_URL=pulsar://localhost:6650
PULSAR_TOPICO_COMANDOS_TRABAJO=persistent://public/default/comandos-trabajo
PULSAR_TOPICO_EVENTOS_TRABAJO=persistent://public/default/eventos-trabajo
PULSAR_SUSCRIPCION_EVENTOS=operaciones-bc
PULSAR_CONSUMIR_EVENTOS=false

# Registra al arrancar los partners con acuerdo vigente (seguros-alpes, banco-andino, muebles-hogar)
SEMBRAR_PARTNERS=true

# Resiliencia de la sincronización con cada partner B2B2C
PARTNER_CB_UMBRAL_FALLOS=3
PARTNER_CB_RECUPERACION_SEGUNDOS=10
PARTNER_SINCRONIZACION_ASINCRONA=true
