  "item": [
    {
      "name": "01 Partners y acuerdos comerciales",
      "item": [
        {
          "name": "Partners con acuerdo y adaptador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('los tres partners iniciales', () => ['seguros-alpes', 'banco-andino', 'muebles-hogar'].forEach(p => pm.expect(pm.response.json().map(p => p.partner_id)).to.include(p)));",
                  "pm.test('todos con adaptador', () => pm.response.json().filter(p => p.partner_id !== 'cooperativa-sur').forEach(p => pm.expect(p.tiene_adaptador).to.eql(true)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{aws_operaciones}}/partners",
              "host": [
                "{{aws_operaciones}}"
              ],
              "path": [
                "partners"
              ]
            }
          }
        },
        {
          "name": "Acuerdo comercial de Seguros de los Alpes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test('tope del plan PLUS', () => pm.expect(Number(p.condiciones.find(c => c.tipo === 'TOPE' && c.clave === 'PLUS').valor)).to.eql(4000000));",
                  "pm.test('red homologada', () => pm.expect(p.red_de_proveedores.length).to.eql(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{aws_operaciones}}/partners/seguros-alpes",
              "host": [
                "{{aws_operaciones}}"
              ],
              "path": [
                "partners",
                "seguros-alpes"
              ]
            },
            "description": "Las reglas del partner son datos del agregado `Partner` (AcuerdoComercial → CondicionComercial), no código del adaptador."
          }
        }
      ]
    },
    {
      "name": "02 Interoperabilidad: traducción de formatos",
      "item": [
        {
          "name": "Seguros de los Alpes (REST propio) → crear siniestro",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('numero_siniestro', 'SA-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 202', () => pm.response.to.have.status(202));",
                  "const r = pm.response.json();",
                  "pm.test('responde en su formato', () => pm.expect(r.numeroSiniestro).to.eql(pm.collectionVariables.get('numero_siniestro')));",
                  "pm.test('estado RECIBIDO', () => pm.expect(r.estado).to.eql('RECIBIDO'));",
                  "pm.test('tope del acuerdo', () => pm.expect(Number(r.topePoliza)).to.eql(4000000));",
                  "pm.test('SLA del acuerdo', () => pm.expect(r.slaHoras).to.eql(24));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{aws_operaciones}}/partners/seguros-alpes/trabajos",
              "host": [
                "{{aws_operaciones}}"
              ],
              "path": [
                "partners",
                "seguros-alpes",
                "trabajos"
              ]
            },
            "description": "El adaptador traduce el formato; el acuerdo del partner resuelve tope, red y SLA; OperacionesBC envía `CrearTrabajoV1` por Pulsar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroSiniestro\": \"{{numero_siniestro}}\",\n  \"poliza\": {\n    \"numero\": \"H-88231\",\n    \"plan\": \"PLUS\"\n  },\n  \"prioridad\": \"ALTA\",\n  \"descripcionSiniestro\": \"Calentador estalló y humedeció el muro\",\n  \"predio\": {\n    \"pais\": \"CO\",\n    \"ciudad\": \"Bogota\",\n    \"direccion\": \"Cra 7 # 45-10\"\n  },\n  \"coberturas\": [\n    {\n      \"codigo\": \"COB-PLOM\",\n      \"detalle\": \"Reparar tubería del calentador\"\n    },\n    {\n      \"codigo\": \"COB-PINT\",\n      \"detalle\": \"Resanar y pintar muro\",\n      \"requiereTerminar\": [\n        \"COB-PLOM\"\n      ]\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Seguros → reintento idempotente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('misma solicitud', () => pm.expect(pm.response.json().numeroSiniestro).to.eql(pm.collectionVariables.get('numero_siniestro')));"
                ]
              }
