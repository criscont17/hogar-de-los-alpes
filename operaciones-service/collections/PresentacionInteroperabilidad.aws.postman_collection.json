              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:ba=\"urn:bancoandino:hogar:v3\">\n  <soapenv:Body>\n    <ba:SolicitudOrdenServicio>\n      <ba:IdOrden>{{id_orden}}</ba:IdOrden>\n      <ba:NivelUrgencia>2</ba:NivelUrgencia>\n      <ba:Resumen>Remodelación de cocina con fuga previa</ba:Resumen>\n      <ba:Inmueble pais=\"MX\" ciudad=\"Ciudad de Mexico\">Av. Paseo de la Reforma 222</ba:Inmueble>\n      <ba:TopeAutorizado moneda=\"MXN\">25000.00</ba:TopeAutorizado>\n      <ba:Actividades>\n        <ba:Actividad etapa=\"1\" oficio=\"FONTANERIA\">Reparar tubería de la tarja</ba:Actividad>\n        <ba:Actividad etapa=\"2\" oficio=\"AZULEJO\">Cambiar azulejo del piso</ba:Actividad>\n        <ba:Actividad etapa=\"2\" oficio=\"ELECTRICIDAD\">Reubicar contactos</ba:Actividad>\n        <ba:Actividad etapa=\"3\" oficio=\"CARPINTERIA\">Instalar gabinetes</ba:Actividad>\n      </ba:Actividades>\n    </ba:SolicitudOrdenServicio>\n  </soapenv:Body>\n</soapenv:Envelope>"
            }
