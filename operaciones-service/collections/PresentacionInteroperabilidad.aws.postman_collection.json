        {
          "name": "Vista canónica en GestionDeTrabajosBC",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "const sub = c => t.sub_trabajos.find(s => s.categoria === c);",
                  "pm.collectionVariables.set('seguros_plomeria_id', sub('Plomeria').id);",
                  "pm.test('canal Partner', () => pm.expect(t.partner_id).to.eql('seguros-alpes'));",
                  "pm.test('condiciones resueltas por OperacionesBC', () => pm.expect([Number(t.monto_maximo), t.sla_horas]).to.eql([4000000, 24]));",
                  "pm.test('requiereTerminar se volvió dependencia', () => pm.expect(sub('Pintura').estado).to.eql('Bloqueado'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{aws_trabajos}}/trabajos/{{seguros_trabajo_id}}",
              "host": [
