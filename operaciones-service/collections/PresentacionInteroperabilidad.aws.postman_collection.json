                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('GestionDeTrabajosBC ya creó el trabajo', () => pm.expect(r.idTrabajoHdA).to.be.a('string'));",
