        {
          "name": "Seguros → consultar estado con su número",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// GestionDeTrabajosBC crea el trabajo de forma asíncrona y OperacionesBC lo proyecta desde sus eventos.",
                  "setTimeout(() => {}, 3000);"
