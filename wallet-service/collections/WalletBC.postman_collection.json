        },
        {
          "name": "Eliminar billetera temporal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 204', () => pm.response.to.have.status(204));",
                  "pm.test('no devuelve cuerpo', () => pm.expect(pm.response.text()).to.be.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/wallet/billeteras/{{billetera_temporal}}",
              "host": ["{{base_url}}"],
              "path": ["wallet", "billeteras", "{{billetera_temporal}}"]
            },
            "description": "Con saldo cero el borrado procede: se va la billetera y, en cascada, sus movimientos. Emite `BilleteraEliminadaV1`."
          }
        },
        {
          "name": "Consultar billetera eliminada → 404",
