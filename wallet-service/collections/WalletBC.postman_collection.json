          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monto\": \"1000.00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/wallet/proveedores/{{$guid}}/wallet/retiros",
              "host": ["{{base_url}}"],
              "path": ["wallet", "proveedores", "{{$guid}}", "wallet", "retiros"]
            }
          }
        },
        {
          "name": "Retirar el saldo restante",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
