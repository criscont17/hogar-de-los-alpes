              "mode": "raw",
              "raw": "{\n  \"monto\": \"70000.00\",\n  \"referencia_externa\": \"retiro-2\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/wallet/proveedores/{{proveedor_retiro}}/wallet/retiros",
              "host": ["{{base_url}}"],
              "path": ["wallet", "proveedores", "{{proveedor_retiro}}", "wallet", "retiros"]
            }
          }
        },
        {
          "name": "Eliminar la billetera del retiro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/wallet/billeteras/{{billetera_retiro}}",
              "host": ["{{base_url}}"],
              "path": ["wallet", "billeteras", "{{billetera_retiro}}"]
            },
            "description": "Solo procede con saldo cero, por eso se retiró todo antes."
          }
        }
      ]
    }
  ]
