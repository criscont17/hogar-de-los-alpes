DATABASE_URL=postgresql+psycopg://wallet:wallet@localhost:5432/wallet_db

# Transporte detrás del puerto MessageBroker: pulsar | logging
MESSAGE_BROKER=logging
PULSAR_URL=pulsar://localhost:6650
PULSAR_TOPICO_EVENTOS_INTEGRACION=persistent://public/default/eventos-wallet-integracion

# Bandeja de salida (patrón Outbox). Con OUTBOX_HABILITADO=false los eventos se
# siguen encolando en la transacción, pero nadie los publica: útil para ver la
# bandeja llenarse en una demostración.
OUTBOX_HABILITADO=true
OUTBOX_INTERVALO_SEGUNDOS=1
OUTBOX_LOTE=50
OUTBOX_MAX_INTENTOS=5
OUTBOX_ESPERA_BASE_SEGUNDOS=2
