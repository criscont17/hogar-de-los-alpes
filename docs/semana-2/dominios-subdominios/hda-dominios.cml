/* =================================================================
 * Hogar de los Alpes (HdA) — Dominios y Sub-dominios
 * Proyecto MISO 2026-14 · Semana 2 · Diseño Estratégico con DDD
 * -----------------------------------------------------------------
 * Arquitectos: Strangler Team
 * Herramienta: ContextMapper DSL
 * =================================================================
 *
 * TIPOS DE SUB-DOMINIO UTILIZADOS
 *   CORE_DOMAIN       — Ventaja competitiva; lógica compleja; desarrollo in-house.
 *   SUPPORTING_DOMAIN — Soporta la operación; lógica simple/transaccional; in-house u outsourcing.
 *   GENERIC_SUBDOMAIN — Capacidad estándar del mercado; sin diferenciación; compra o open-source.
 */

/* ---------------------------------------------------------------
 * DOMINIO 1: Plataforma Marketplace
 * Canal B2C — experiencia del propietario de hogar
 * --------------------------------------------------------------- */
Domain PlataformaMarketplace {
    domainVisionStatement "Proveer a los propietarios de hogares en Colombia y Latinoamérica una experiencia inteligente, segura y transparente para solicitar servicios del hogar, guiados por un asistente conversacional basado en IA que diagnostica el problema, crea el trabajo y conecta al usuario con el proveedor más adecuado en tiempo y forma."

    Subdomain AsistenteConversacional {
        type = CORE_DOMAIN
        domainVisionStatement "Ofrecer un asistente de IA conversacional que diagnostica problemas del hogar en lenguaje natural, clasifica el trabajo por categoría y urgencia, y produce una especificación estructurada lista para publicación, eliminando la fricción en la creación de trabajos para el usuario final y garantizando datos de alta calidad para la orquestación posterior."
    }

    Subdomain PublicacionYBusqueda {
        type = CORE_DOMAIN
        domainVisionStatement "Publicar los trabajos creados a los proveedores acreditados que coinciden en categoría de servicio, zona geográfica y disponibilidad, maximizando la velocidad de asignación y la calidad del match entre la demanda del hogar y la oferta del proveedor."
    }

    Subdomain GestionDeCotizaciones {
        type = CORE_DOMAIN
        domainVisionStatement "Gestionar el proceso de cotización multiproveedor, permitiendo al cliente comparar propuestas, solicitar información adicional o visitas previas al predio, y seleccionar la opción que mejor se adapte a sus necesidades con total transparencia de costos, tiempos y condiciones."
    }

    Subdomain NotificacionesYComunicacion {
        type = GENERIC_SUBDOMAIN
        domainVisionStatement "Proveer los mecanismos de comunicación multicanal (push, email, SMS, in-app) para mantener informados a clientes, proveedores y agentes en cada etapa del ciclo de vida del trabajo. Capacidad estandarizada disponible en el mercado como servicio."
    }

}

/* ---------------------------------------------------------------
 * DOMINIO 2: Orquestación de Trabajos
 * Núcleo tecnológico diferenciador de HdA — ciclo de vida del trabajo
 * --------------------------------------------------------------- */
Domain OrquestacionDeTrabajos {
    domainVisionStatement "Ser el núcleo tecnológico diferenciador de HdA, orquestando el ciclo de vida completo de los trabajos del hogar con capacidad de gestionar flujos complejos, sub-trabajos con dependencias, novedades en curso y cambios de alcance, manteniendo la consistencia del estado para todas las partes involucradas en cualquier tipo de trabajo: marketplace, siniestros o instalaciones."

    Subdomain GestionDeFlujosDeTrabajos {
        type = CORE_DOMAIN
        domainVisionStatement "Construir y ejecutar el flujo correcto para cada trabajo: determinar el orden de los sub-trabajos, identificar las actividades que pueden ejecutarse en paralelo y gestionar las actividades bloqueantes (ej. no se instalan muebles si la tubería no está lista), adaptándose dinámicamente a cambios de alcance en plena ejecución sin perder la consistencia del estado para ninguna de las partes."
    }

    Subdomain SeguimientoYNovedades {
        type = SUPPORTING_DOMAIN
        domainVisionStatement "Proveer visibilidad en tiempo real del estado de los trabajos a clientes, proveedores, agentes y partners, registrando todas las novedades, re-diagnósticos, cancelaciones y eventos que modifiquen el flujo original, desencadenando las acciones compensatorias de re-cotización o re-asignación cuando corresponda."
    }

    Subdomain CalidadYDisputas {
        type = SUPPORTING_DOMAIN
        domainVisionStatement "Gestionar el cierre de calidad de los trabajos, incluyendo la recolección de evidencias, la resolución de disputas entre clientes y proveedores, la aplicación de garantías posventa y la calificación del servicio prestado que retroalimenta el sistema de reputación de la plataforma."
    }

}

/* ---------------------------------------------------------------
 * DOMINIO 3: Proveedores de Servicio
 * Confianza y verificación — diferenciador de seguridad de HdA
 * --------------------------------------------------------------- */
Domain ProveedoresDeServicio {
    domainVisionStatement "Construir y mantener la red de proveedores más confiable de Latinoamérica, garantizando que cada persona natural o empresa habilitada haya superado un proceso de verificación riguroso, y que su reputación, cobertura y habilitaciones estén siempre actualizadas para proteger la seguridad de los hogares y la integridad de la operación."

    Subdomain VerificacionYAcreditacion {
        type = CORE_DOMAIN
        domainVisionStatement "Ejecutar el proceso de verificación de proveedores mediante acceso a múltiples sistemas externos (antecedentes judiciales, registros empresariales, entidades certificadoras), asistido por IA para optimizar velocidad y precisión sin sacrificar la rigurosidad que diferencia a HdA en el mercado. Incluye re-validaciones periódicas y por novedades de personal en empresas de servicio."
    }

    Subdomain RegistroDeProveedores {
        type = SUPPORTING_DOMAIN
        domainVisionStatement "Gestionar el proceso de incorporación de nuevos proveedores —personas naturales y empresas de servicios— al ecosistema de HdA, capturando sus servicios declarados, credenciales, zona de cobertura y tipo de proveedor como punto de entrada al proceso de verificación."
    }

    Subdomain ReputacionYCalificaciones {
        type = CORE_DOMAIN
        domainVisionStatement "Construir y mantener el perfil de reputación de cada proveedor a partir de calificaciones de clientes, cumplimiento de SLAs, historial de garantías y auditorías periódicas, utilizando estos datos para priorizar la asignación de trabajos futuros y fortalecer la confianza de los clientes en la seguridad de la plataforma."
    }

    Subdomain GestionDeCoberturaGeografica {
        type = SUPPORTING_DOMAIN
        domainVisionStatement "Administrar la cobertura geográfica declarada por cada proveedor (ciudades y zonas específicas), garantizando que los trabajos se publiquen únicamente a quienes están habilitados y acreditados para operar en la zona del cliente."
    }

}

/* ---------------------------------------------------------------
 * DOMINIO 4: Siniestros e Integraciones B2B2C
 * Canal B2B2C — aseguradoras, bancos y comercios
 * --------------------------------------------------------------- */
Domain SiniestrosEIntegraciones {
    domainVisionStatement "Posicionar a HdA como el operador de referencia para aseguradoras, bancos y comercios en la gestión de siniestros del hogar e instalaciones asociadas a ventas, con capacidad de adaptarse a las reglas, compliance y SLAs particulares de más de 30 partners activos, procesando millones de requests diarios con alta disponibilidad y escalabilidad para los picos de eventos climáticos."

    Subdomain GestionDeSiniestros {
        type = CORE_DOMAIN
        domainVisionStatement "Gestionar el ciclo de vida completo de los trabajos de siniestros e instalaciones creados por partners B2B2C, desde la recepción del evento hasta el cierre y facturación, respetando las redes de proveedores permitidas, montos máximos, pasos de aprobación y requisitos de evidencia específicos de cada aseguradora, banco o comercio."
    }

    Subdomain IntegracionesB2B2C {
        type = CORE_DOMAIN
        domainVisionStatement "Proveer las integraciones de alta disponibilidad y alto volumen con los sistemas de los partners B2B2C, procesando millones de requests diarios para creación de trabajos, consultas de estado, sincronización de evidencias y facturación, con elasticidad para escalar hasta 4 veces el volumen habitual ante eventos climáticos o picos de siniestros."
    }

    Subdomain MotorDeReglasDePartner {
        type = CORE_DOMAIN
        domainVisionStatement "Modelar y ejecutar las reglas de negocio, pasos de compliance, SLAs, redes de proveedores homologados y condiciones comerciales de cada partner B2B2C, permitiendo que HdA gestione universos operativos completamente distintos entre sí sin duplicar la lógica central ni comprometer la coherencia del sistema."
    }

    Subdomain FacturacionYEvidencias {
        type = SUPPORTING_DOMAIN
        domainVisionStatement "Consolidar las evidencias del trabajo realizado (fotos, reportes, firmas digitales) y generar la facturación correspondiente al partner según el acuerdo comercial vigente, garantizando la trazabilidad y el cumplimiento de los requisitos de auditoría de cada contrato."
    }

}

/* ---------------------------------------------------------------
 * DOMINIO 5: Finanzas y Fintech
 * Pagos de la plataforma y servicios financieros para proveedores
 * --------------------------------------------------------------- */
Domain FinanzasYFintech {
    domainVisionStatement "Garantizar la fluidez y seguridad de los pagos en toda la plataforma y democratizar el acceso a servicios financieros para los proveedores independientes de HdA —muchos sin historial bancario formal— utilizando el historial de trabajos completados como fuente alternativa de scoring crediticio para ofrecer wallets, anticipos y micro-préstamos que impulsen el crecimiento de sus negocios."

    Subdomain WalletYPrestamos {
        type = CORE_DOMAIN
        domainVisionStatement "Ofrecer servicios financieros diferenciados a los proveedores independientes de HdA a través de una billetera digital, pagos anticipados y micro-préstamos, construyendo un scoring crediticio alternativo basado en el historial de trabajos completados, cumplimiento de SLAs y calificaciones recibidas en la plataforma, sin requerir historial bancario tradicional."
    }

    Subdomain ProcesoDePagos {
        type = GENERIC_SUBDOMAIN
        domainVisionStatement "Procesar de forma segura los pagos de clientes a proveedores —retenidos en custodia hasta la finalización del trabajo—, las transferencias entre partes y las liquidaciones periódicas, apoyándose en pasarelas de pago estándar de la industria disponibles en cada país de operación."
    }

    Subdomain RiesgoYCumplimiento {
        type = GENERIC_SUBDOMAIN
        domainVisionStatement "Gestionar el riesgo financiero de la operación y garantizar el cumplimiento de las regulaciones aplicables en cada país (prevención de lavado de activos, control de fraude transaccional, normativa fintech local), apoyándose en herramientas y estándares de la industria financiera."
    }

}

/* ---------------------------------------------------------------
 * DOMINIO 6: Expansión y Operaciones
 * Escalabilidad operativa y expansión regional
 * --------------------------------------------------------------- */
Domain ExpansionYOperaciones {
    domainVisionStatement "Garantizar la escalabilidad operativa de HdA en su expansión a México, Brasil y Argentina, adaptando la plataforma a las regulaciones, monedas, husos horarios y contextos locales de cada mercado, y habilitando al equipo de agentes humanos para mantener la calidad operativa ante el incremento sostenido de volumen derivado del crecimiento regional."

    Subdomain ConfiguracionRegional {
        type = SUPPORTING_DOMAIN
        domainVisionStatement "Gestionar la configuración específica de cada país de operación (moneda, idioma, regulaciones laborales y fiscales, husos horarios, partners locales), permitiendo que la plataforma opere de forma coherente en múltiples mercados sin duplicar la lógica central del negocio."
    }

    Subdomain GestionDeAgentes {
        type = SUPPORTING_DOMAIN
        domainVisionStatement "Proveer las herramientas y flujos necesarios para que el equipo de agentes humanos de HdA coordine, monitoree y resuelva incidentes durante el ciclo de vida de los trabajos, optimizando su capacidad de respuesta a medida que crece el volumen de operaciones con la expansión regional."
    }

    Subdomain AlianzasComerciales {
        type = SUPPORTING_DOMAIN
        domainVisionStatement "Gestionar las relaciones comerciales y los acuerdos contractuales con los partners B2B2C (aseguradoras, bancos y comercios), facilitando la incorporación de nuevos socios y la renegociación de condiciones conforme HdA expande su operación a nuevos mercados de Latinoamérica."
    }

}

