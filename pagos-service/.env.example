DATABASE_URL=postgresql+psycopg://pagos:pagos@localhost:5435/pagos_db

# Adaptador de mensajería: logging (sin infraestructura) | pulsar
MESSAGE_BROKER=logging
PULSAR_URL=pulsar://localhost:6650
PULSAR_TOPICO_EVENTOS_PAGO=persistent://public/default/eventos-pago
PULSAR_TOPICO_EVENTOS_TRABAJO=persistent://public/default/eventos-trabajo
PULSAR_SUSCRIPCION_EVENTOS_TRABAJO=pagos-bc
PULSAR_CONSUMIR_EVENTOS_TRABAJO=false

# Resiliencia de la integración con cada PSP (Interoperabilidad #7)
PSP_CB_UMBRAL_FALLOS=3
PSP_CB_RECUPERACION_SEGUNDOS=10.0
